            {
              "type": "null"
            }
          ],
          "title": "Confidence",
          "description": "Your subjective probability, from 0 to 1, that the selected direction will be the challenge's final settled outcome. Required with `direction`; when `probabilities` is provided it is derived as the vector's maximum (any explicit value must match)."
        },
        "probabilities": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probabilities",
          "description": "Full probability vector over ALL THREE outcomes, e.g. {\"bearish\": 0.60, \"neutral\": 0.35, \"bullish\": 0.05}. Keys must be exactly bearish/neutral/bullish, values non-negative and summing to 1 (tolerance 1e-6). Preferred over direction+confidence: your exact vector is Brier-scored as submitted, instead of splitting the residual (1-confidence) evenly across the other two outcomes."
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ],
